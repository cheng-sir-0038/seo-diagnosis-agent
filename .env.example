# SEO Diagnosis Agent 环境变量配置
# 复制此文件为 .env.local 并填入真实值
# .env.local 已被 .gitignore 排除，不会提交到版本控制

# ---- 运行环境 ----
ENVIRONMENT=development
DEBUG=true

# ---- 服务绑定 ----
HOST=127.0.0.1
PORT=8000

# ---- 缓存与存储 ----
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=data/evidence.db
CACHE_DEFAULT_TTL=300

# ---- DataForSEO API (P0 — 外部竞争全景) ----
# 注册地址: https://app.dataforseo.com/api-access
# 认证方式: HTTP Basic Auth (login:password Base64)
DATAFORSEO_API_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_API_KEY=
DATAFORSEO_RATE_LIMIT=30

# ---- Google PageSpeed Insights API v5（页面级 Lighthouse 实验室检测） ----
# 正式 SEO Agent 工具要求配置 API Key；只放在 .env.local，不提交真实值。
PAGESPEED_API_BASE_URL=https://pagespeedonline.googleapis.com/pagespeedonline/v5
PAGESPEED_API_KEY=
PAGESPEED_RATE_LIMIT=10
PAGESPEED_REQUEST_TIMEOUT=120
PAGESPEED_MAX_RETRIES=2
PAGESPEED_DEFAULT_STRATEGY=mobile
PAGESPEED_DEFAULT_LOCALE=zh-CN
PAGESPEED_MAX_OPPORTUNITIES=10

# ---- Direct page HTML metadata（无需第三方 API Key） ----
PAGE_METADATA_REQUEST_TIMEOUT=20
PAGE_METADATA_MAX_RESPONSE_BYTES=2000000
PAGE_METADATA_MAX_REDIRECTS=5
PAGE_METADATA_USER_AGENT=SEO-Agent-MetadataBot/1.0

# ---- python-seo-analyzer（独立环境，不安装进主 Python） ----
# Docker 镜像会自动启用并指向 /opt/pyseoanalyzer/bin/python。
# 本地开发需先建立隔离 venv，再填写其 Python 路径。
PYTHON_SEO_ANALYZER_ENABLED=false
PYTHON_SEO_ANALYZER_PYTHON=
PYTHON_SEO_ANALYZER_TIMEOUT=8
PYTHON_SEO_ANALYZER_MAX_OUTPUT_BYTES=1000000

# ---- Serper.dev API (P2 — Google 搜索，替代已关闭的 Google Custom Search JSON API) ----
# 注册地址: https://serper.dev
SERPER_API_BASE_URL=https://google.serper.dev
SERPER_API_KEY=
SERPER_REQUEST_TIMEOUT=30
SERPER_MAX_RETRIES=2
SERPER_DEFAULT_LANGUAGE=en

# ---- Ahrefs API (以后启用 — 替换 client._pseudo_response() 即可) ----
AHREFS_API_BASE_URL=https://api.ahrefs.com/v3
AHREFS_API_KEY=
AHREFS_RATE_LIMIT=50
AHREFS_REQUEST_TIMEOUT=30

# ---- Agent 模型配置 ----
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_REQUEST_TIMEOUT=60
# AGENT_MAX_ITERATIONS=8
# AGENT_MAX_TOOL_CALLS=12
# AGENT_TOOL_TIMEOUT=15

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- SEO Agent persistence ----
SEO_AGENT_SQLITE_PATH=data/seo-agent.db
LANGGRAPH_CHECKPOINT_SQLITE_PATH=data/langgraph-checkpoints.db
LANGGRAPH_STRICT_MSGPACK=true
SEO_AGENT_GRAPH_VERSION=v1
SEO_AGENT_POLICY_VERSION=v1

# ---- Email notification (QQ SMTP example) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_AUTH_CODE=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SEO优化专员
APPROVAL_REMINDER_INTERVAL_HOURS=24
LOCAL_SCHEDULER_ENABLED=true

# ---- Independent HTML site publisher ----
HTML_SITE_ROOT_PATH=data/html-site
HTML_SITE_BASE_URL=http://localhost:8080
HTML_SITE_CONTENT_SUBDIR=
HTML_SITE_REQUEST_TIMEOUT=15
MONITORING_INDEXING_DAYS=3,7,14,28
MONITORING_RANKING_WEEKS=8

# ---- Automation workers ----
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_OUTBOX_INTERVAL_MINUTES=1
AUTOMATION_SCHEDULE_SYNC_MINUTES=5

# Agent Observability Core
OBSERVABILITY_SQLITE_PATH=data/agent-observability.db
OBSERVABILITY_PROJECT_KEY=seo-agent
OBSERVABILITY_PROJECT_NAME=SEO Agent
OBSERVABILITY_SERVICE_NAME=seo-agent-api
OBSERVABILITY_JSONL_ENABLED=false
OBSERVABILITY_JSONL_PATH=data/observability/events.jsonl
OBSERVABILITY_OTLP_ENDPOINT=
# 可选：在 .env.local 中配置 Langfuse Cloud 项目密钥；不要提交密钥。
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Agent Runtime Harness
AGENT_CONTEXT_MESSAGE_LIMIT=24
AGENT_CONTEXT_CHARACTER_LIMIT=50000
AGENT_CHAT_RECOVERY_ENABLED=true
